# Memory Crystal — Self-Hosted Stack
# Copy this file to .env and fill in the values.
# Issued at signup on memorycrystal.ai — see https://docs.memorycrystal.ai/configuration/self-hosting

MC_VERSION=0.10.0
MC_TENANT_SLUG=your-slug-here
MC_TUNNEL_TOKEN=  # Issued during signup at memorycrystal.ai
MC_BOOTSTRAP_TOKEN=  # Single-use, 1h TTL — issued during signup

# Optional overrides
# DASHBOARD_PORT=6791
# RUST_LOG=info
