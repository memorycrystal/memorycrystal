# Memory Crystal — Self-Hosted Stack
# Copy this file to .env and fill in the values.
# Issued at signup on memorycrystal.ai — see https://memorycrystal.ai/docs/self-hosted

MC_VERSION=v1.0.0
MC_TENANT_SLUG=your-slug-here
MC_TUNNEL_TOKEN=  # Issued during signup at memorycrystal.ai
MC_BOOTSTRAP_TOKEN=  # Single-use, 1h TTL — issued during signup

# Optional overrides
# DASHBOARD_PORT=6791
# RUST_LOG=info
