+async fn delete_expired_export_blob(
+    object_key: &common::types::ObjectKey,
+    delete_result: impl Future<Output = anyhow::Result<()>>,
+) -> anyhow::Result<()> {
+    match delete_result.await {
+        Ok(()) => {
+            log_exports_s3_cleanup();
+            Ok(())
+        },
+        Err(error)
+            if error
+                .downcast_ref::<std::io::Error>()
+                .map(|error| error.kind())
+                == Some(std::io::ErrorKind::NotFound) =>
+        {
+            tracing::warn!(object_key = ?object_key, "Expired export blob was already missing");
+            Ok(())
+        },
+        Err(error) => Err(error),
+    }
+}
