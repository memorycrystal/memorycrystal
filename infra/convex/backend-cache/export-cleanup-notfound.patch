+#[cfg(test)]
+mod export_cleanup_tests {
+    use common::{
+        runtime::Runtime,
+        types::ObjectKey,
+    };
+    use runtime::prod::ProdRuntime;
+    use storage::{
+        LocalDirStorage,
+        Storage,
+    };
+
+    use super::delete_expired_export_blob;
+
+    // The open-source tree ships no `TestRuntime`, so these tests drive the
+    // production runtime from plain `#[test]` functions. `init_tokio` refuses
+    // to run inside a Tokio context, so `#[tokio::test]` cannot be used.
+
+    // This key represents the zip_object_key selected from an expired
+    // Completed export by ExportsModel::cleanup_expired.
+    #[test]
+    fn cleanup_expired_export_with_missing_local_blob_returns_ok() -> anyhow::Result<()> {
+        let tokio_rt = ProdRuntime::init_tokio()?;
+        let rt = ProdRuntime::new(&tokio_rt);
+        let storage = LocalDirStorage::new(rt.clone())?;
+        let object_key = ObjectKey::try_from(rt.new_uuid_v4().to_string())?;
+
+        let result = tokio_rt.block_on(delete_expired_export_blob(
+            &object_key,
+            storage.delete_object(&object_key),
+        ));
+
+        assert!(result.is_ok(), "a missing expired export blob is tolerated");
+        Ok(())
+    }
+
+    #[test]
+    fn cleanup_expired_export_propagates_non_not_found_storage_error() -> anyhow::Result<()> {
+        let tokio_rt = ProdRuntime::init_tokio()?;
+        let rt = ProdRuntime::new(&tokio_rt);
+        let object_key = ObjectKey::try_from(rt.new_uuid_v4().to_string())?;
+        let injected_error = std::io::Error::new(
+            std::io::ErrorKind::PermissionDenied,
+            "injected export storage failure",
+        );
+
+        let result = tokio_rt.block_on(delete_expired_export_blob(&object_key, async {
+            Err(anyhow::Error::from(injected_error))
+        }));
+
+        let error = result.expect_err("non-NotFound errors must propagate");
+        assert_eq!(
+            error
+                .downcast_ref::<std::io::Error>()
+                .map(|error| error.kind()),
+            Some(std::io::ErrorKind::PermissionDenied),
+        );
+        Ok(())
+    }
+}
