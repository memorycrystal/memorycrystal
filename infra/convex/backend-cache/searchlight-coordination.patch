+        Self {
+            paths,
+            _segment_meta: segment_meta,
+            _uuids_meta: uuids_meta,
+            _deleted_meta: deleted_meta,
+        }
+    }
+}
+
+// Hash and Eq based on paths only (metadata is for lifetime, not identity)
+impl std::hash::Hash for VectorSegmentPaths {
+    fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
+        self.paths.hash(state);
+    }
+}
+
+impl PartialEq for VectorSegmentPaths {
+    fn eq(&self, other: &Self) -> bool {
+        self.paths == other.paths
+    }
+}
