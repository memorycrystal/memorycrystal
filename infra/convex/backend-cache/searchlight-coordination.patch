+    pub paths: UntarredVectorDiskSegmentPaths,
+    /// Held IndexMeta references keep archive dirs alive
+    _segment_meta: Arc<IndexMeta>,
+    _uuids_meta: Arc<IndexMeta>,
+    _deleted_meta: Arc<IndexMeta>,
+}
+
+impl VectorSegmentPaths {
