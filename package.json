{
  "name": "memorycrystal",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "mcp-server",
    "infra/cloudflare/worker"
  ],
  "testedWith": {
    "_comment": "Advisory host compatibility as of 2026-07-01. Does not block installs; doctor emits soft warnings only. Keep in lockstep with apps/web/public/install.sh and scripts/crystal-doctor.sh.",
    "openclaw": "2026.6.1",
    "hermes": "v0.14.0",
    "claude-code": "2.1.197",
    "codex-cli": "0.142.5",
    "codex-desktop": "0.142.5",
    "claude-desktop": "cowork-ga",
    "factory-droid": "0.162.0"
  },
  "scripts": {
    "dev": "cd apps/web && npm run dev",
    "build": "cd apps/web && npm run build",
    "crystal:init": "bash scripts/crystal-init.sh",
    "crystal:bootstrap": "bash scripts/crystal-bootstrap.sh",
    "crystal:doctor": "bash scripts/crystal-doctor.sh",
    "crystal:enable": "bash scripts/crystal-enable.sh",
    "crystal:disable": "bash scripts/crystal-disable.sh",
    "crystal:e2e": "bash scripts/crystal-e2e.sh",
    "convex:deploy": "CONVEX_DEPLOYMENT=prod:rightful-mockingbird-389 npx convex deploy",
    "test:smoke": "bash scripts/crystal-doctor.sh --smoke",
    "test:capture-e2e": "node scripts/test-capture-e2e.cjs",
    "convex:cost-smoke": "node scripts/convex-cost-smoke.mjs",
    "install:hooks": "node scripts/install-hooks.mjs",
    "sync:public": "node scripts/sync-public.mjs --dry-run",
    "install:sweeper": "node scripts/install-launchd-plist.mjs",
    "convex:local:up": "bash scripts/convex-local-up.sh",
    "convex:local:down": "bash scripts/convex-local-down.sh",
    "convex:local:doctor": "bash scripts/convex-local-doctor.sh",
    "convex:local:reset": "bash scripts/convex-local-down.sh --wipe && npm run convex:local:up",
    "convex:local:seed": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON' node --experimental-strip-types scripts/convex-local-seed.ts",
    "convex:local:auth-keys": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON' node --experimental-strip-types scripts/convex-local-auth-keys.ts",
    "convex:local:provision-env": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON' node --experimental-strip-types scripts/convex-local-provision-env.ts",
    "convex:local:write-env": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON' node --experimental-strip-types scripts/convex-local-write-env.ts",
    "web:backend:local": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON' node --experimental-strip-types scripts/web-backend-env.ts local",
    "web:backend:remote": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON' node --experimental-strip-types scripts/web-backend-env.ts remote",
    "test:local": "bash test-local.sh",
    "test:remote": "bash test-remote.sh",
    "package:local-backend": "node scripts/package-local-backend.mjs",
    "chaos": "vitest run --config vitest.config.chaos.ts",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "convex": "^1.35.1",
    "convex-test": "^0.0.41",
    "eslint-plugin-local-rules": "^3.0.2",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "router": {
      "path-to-regexp": "8.4.0"
    },
    "vite": "7.3.5",
    "hono": "4.12.25",
    "@hono/node-server": "1.19.13",
    "express-rate-limit": "8.5.2",
    "fast-uri": "3.1.2",
    "qs": "6.15.2",
    "postcss": "8.5.16",
    "ws": "8.21.0"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "1.32.0",
    "lightningcss-darwin-x64": "1.32.0",
    "lightningcss-linux-arm64-gnu": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "packageManager": "npm@10.9.4"
}
