CONVEX_URL=https://your-deployment.convex.cloud
MEMORY_CRYSTAL_REMOTE_CONVEX_URL=https://your-deployment.convex.cloud
MEMORY_CRYSTAL_REMOTE_CONVEX_SITE_URL=https://your-deployment.convex.site
# Google Gemini API key for embeddings.
GEMINI_API_KEY=
# Optional model-routing key for organic memory features.
OPENROUTER_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
