{
  "name": "@memorycrystal/mcp-server",
  "version": "0.8.20",
  "description": "MCP server for Memory Crystal — persistent memory for AI assistants",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "crystal-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "CLAUDE.md",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:crystal": "node --env-file-if-exists=.env dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "claude",
    "codex",
    "persistent-memory"
  ],
  "testedWith": {
    "_note": "Advisory host-client compatibility. Not a hard requirement; install is never blocked. As of 2026-07-01.",
    "clients": {
      "claude-code": "2.1.197",
      "codex-cli": "0.142.5",
      "codex-desktop": "0.142.5",
      "claude-desktop": "Sonnet 4.6 / Cowork GA",
      "factory-droid": "0.162.0"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "convex": "^1.35.1",
    "openai": "^4.82.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
